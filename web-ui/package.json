{
  "name": "guc-members",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "release": "ng build --aot true --configuration production --optimization true --base-href / --output-hashing bundles --subresource-integrity true --allowed-common-js-dependencies 'base64-js, js-sha256' --source-map true",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch false --progress true",
    "test:firefox": "ng test --configuration=firefox",
    "test:watch": "ng test --watch",
    "test:interactive": "ng test --configuration=interactive",
    "lint": "ng lint"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.2.4",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/material": "^22.2.4",
    "@angular/material-date-fns-adapter": "^22.2.4",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@ngrx/effects": "^22.0.1",
    "@ngrx/operators": "^22.0.1",
    "@ngrx/store": "^22.0.1",
    "@ngrx/store-devtools": "^22.0.1",
    "angular-auth-oidc-client": "19.0.0",
    "date-fns": "^4.4.0",
    "eta": "^4.0.1",
    "js-base64": "^3.7.8",
    "jwt-decode": "^4.0.0",
    "keycloak-js": "^23.0.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.6.0",
    "@angular-eslint/eslint-plugin": "22.6.0",
    "@angular-eslint/eslint-plugin-template": "22.6.0",
    "@angular-eslint/schematics": "22.6.0",
    "@angular-eslint/template-parser": "22.6.0",
    "@angular/build": "^22.1.9",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.3",
    "@ngrx/schematics": "^22.0.1",
    "baseline-browser-mapping": "^2.11.32",
    "eslint": "^9.22.0",
    "@vitest/browser-webdriverio": "^4.0.18",
    "jsdom": "^27.4.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.27.3": true,
    "@parcel/watcher@2.6.0": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true,
    "edgedriver@8.0.0": true,
    "geckodriver@8.0.0": true
  }
}
